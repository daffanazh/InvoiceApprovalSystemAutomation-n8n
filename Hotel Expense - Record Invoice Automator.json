            "department": "={{ (() => { try { let item = $('Analyze document').first().json; let parts = item.content?.parts || []; let t = ''; for(let i=parts.length-1; i>=0; i--){ if(parts[i].text && parts[i].text.includes('{')) { t = parts[i].text; break; } } if(!t) t = item.text || ''; t = t.replace(/```json/gi, '').replace(/```/g, ''); let start = t.indexOf('{'); let end = t.lastIndexOf('}'); return JSON.parse(t.substring(start, end + 1)).department || 'Cek Manual'; } catch(e) { return 'Cek Manual'; } })() }}",
